# --- Twilio -------------------------------------------------------------
# From the "Twilio GCS API" credential.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=

# Public base URL Twilio can reach. Used to build callback URLs AND to
# validate inbound webhook signatures - if this is wrong, every webhook
# 403s. Must match exactly what Twilio is configured to call.
PUBLIC_BASE_URL=https://telephony.dssmultiservices.ca

# Set to 1 only for local development against the Twilio CLI emulator.
# Never in an environment Twilio can actually reach.
SKIP_SIGNATURE_VALIDATION=0

# --- Storage ------------------------------------------------------------
# local | gcs
STORAGE_DRIVER=local

# STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./recordings

# STORAGE_DRIVER=gcs
GCS_BUCKET=
GCS_KEY_FILE=

# Recordings older than this are pruned by the retention sweep.
# Bounds storage cost permanently and keeps PIPEDA retention defensible.
RETENTION_DAYS=365

# --- Voice --------------------------------------------------------------
# Bilingual recording-consent announcement is played before the bridge.
# Disabling this in Quebec is a legal decision, not a technical one.
PLAY_RECORDING_NOTICE=1

# --- Vonage / WhatsApp --------------------------------------------------
# From the "Vonage GCS" credential. WhatsApp routes only mount when the key,
# secret, and from-number are all set.
VONAGE_API_KEY=
VONAGE_API_SECRET=

# "Signed Webhooks Signature secret" on the Vonage item. Required whenever
# Vonage is configured - without it inbound webhooks cannot be verified.
VONAGE_SIGNATURE_SECRET=

# Sending number, digits only, no leading +.
VONAGE_WHATSAPP_NUMBER=

# Production: https://api.nexmo.com
# Sandbox:    https://messages-sandbox.nexmo.com  (no WABA needed, allowlisted
#             recipients only - use this for the first end-to-end test)
VONAGE_MESSAGES_BASE_URL=https://api.nexmo.com

# Sandbox does not sign webhooks. Never set this against production.
VONAGE_SKIP_SIGNATURE_VALIDATION=0

# Shared secret for POST /admin/whatsapp/send, which originates billable
# traffic. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

PORT=8080

# --- Transcripcion local (paso "Hermes") -------------------------------
# Sustituye la transcripcion de Twilio, que es el grueso del ahorro.
# Necesita whisper.cpp (brew install whisper-cpp) y un modelo ggml.
TRANSCRIPTION_ENABLED=0
WHISPER_CLI_PATH=whisper-cli
WHISPER_MODEL_PATH=
FFMPEG_PATH=ffmpeg
WHISPER_LANGUAGE=en
WHISPER_TIMEOUT_MS=300000

# --- Puente a Hermes ----------------------------------------------------
# Vacio = puente dormido: los mensajes se reciben y registran, pero no se
# responden. Desde el contenedor, Hermes esta en el loopback del HOST:
#   http://host.docker.internal:8644/webhooks/<nombre-de-la-ruta>
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=
HERMES_SIGNATURE_HEADER=X-Hermes-Signature
HERMES_TIMEOUT_MS=120000

# --- Buzon de voz -------------------------------------------------------
RING_SECONDS=13
VOICEMAIL_ENABLED=1
VOICEMAIL_MAX_SECONDS=180
# Avisa al empleado por SMS con la transcripcion local. WhatsApp no sirve
# aqui: fuera de la ventana de 24h exige plantilla aprobada.
VOICEMAIL_NOTIFY_SMS=1
TWILIO_SMS_FROM=
