{
  "name": "dss-telephony",
  "version": "0.1.0",
  "private": true,
  "description": "Voice recording archival and messaging orchestration for DSS Multiservices",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node --watch --env-file=.env dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "twilio": "^5.4.0"
  },
  "optionalDependencies": {
    "@google-cloud/storage": "^7.14.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
