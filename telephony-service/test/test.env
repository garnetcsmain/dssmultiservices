# Environment for `npm test`. Nothing here reaches a real provider: the tests
# cover pure logic (parsing, signing, routing decisions), and every credential
# below is a placeholder that exists only to satisfy config.ts at import.
PUBLIC_BASE_URL=https://test.invalid
TWILIO_ACCOUNT_SID=ACtest00000000000000000000000000
TWILIO_AUTH_TOKEN=test-auth-token
MEDIA_SIGNING_SECRET=test-signing-secret
MEDIA_ROOT=./.test-media
LOCAL_STORAGE_ROOT=./.test-recordings
